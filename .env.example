# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NEWS_API_KEY: Required for NewsAPI.org top headlines and categories
NEWS_API_KEY="YOUR_NEWS_API_KEY"

# GOOGLE ADSENSE: Publisher Client ID
VITE_ADSENSE_CLIENT_ID="ca-pub-8153839325985487"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Email Configuration for Bulk Email Dispatch
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USE_TLS="true"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"
EMAIL_FROM="PulseNews <your-email@gmail.com>"
